{
    "name": "paytracker-e2e",
    "private": true,
    "description": "Playwright end-to-end test suite for PayTracker. Lives alongside the PHP app in the same repo so each feature branch can ship its own specs in lockstep with the controller changes that motivate them.",
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "css:build": "tailwindcss -i ./resources/css/app.css -o ./public/assets/app.css --minify",
        "css:watch": "tailwindcss -i ./resources/css/app.css -o ./public/assets/app.css --watch",
        "fonts:copy": "node scripts/copy-fonts.mjs",
        "assets:build": "npm run fonts:copy && npm run css:build"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.1.0",
        "@fontsource/jetbrains-mono": "^5.1.0",
        "@playwright/test": "^1.49.0",
        "@tailwindcss/forms": "^0.5.10",
        "@types/node": "^22.0.0",
        "tailwindcss": "^3.4.17"
    },
    "engines": {
        "node": ">=20"
    }
}
