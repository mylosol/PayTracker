# --- Dependency folders ------------------------------------------------------
node_modules/
jspm_packages/
vendor/

# --- Environment files (CRITICAL: never commit secrets) ----------------------
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Legacy PHP secrets (still present in the unmodernized root) ------------
db.php
include/db.php
googleMapsAPI.php
include/googleMapsAPI.php

# --- Build / runtime artefacts ----------------------------------------------
storage/logs/*.log
storage/cache/*
storage/sessions/sess_*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/sessions/.gitkeep
# Tailwind CSS is compiled in CI before rsync; never committed.
public/assets/app.css

# --- Playwright artefacts ---------------------------------------------------
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# --- OS metadata ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Log files and debug dumps ----------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*

# --- IDE / editor -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
