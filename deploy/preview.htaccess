# Preview-channel root .htaccess.
#
# Placed by the GitHub Actions preview-deploy workflow at the docroot
# (typically /home/<user>/domains/preview.paytracker.xyz/public_html/.htaccess).
# Routes every URL that doesn't map to a real file or directory through
# the modern front controller in public/index.php.
#
# This file is intentionally NOT named `.htaccess` in the repository so
# it stays inert during local development — the workflow renames it on
# deploy.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to the application source tree. Only
    # the `public/` directory is meant to be web-reachable; everything
    # else is framework guts.
    RewriteRule ^(app|bootstrap|config|routes|resources|storage|tests|vendor|deploy|docs|scripts)(/|$) - [F,L]

    # Static-asset passthrough — ONLY serve real files under public/
    # directly. The URI-scope condition is what isolates the modern
    # app from any legacy code or directories that might still live
    # at the docroot (Robert's host migration left a few of those
    # around). A request for /admin/ that happens to resolve to a
    # legacy admin/ directory on disk does NOT get served by Apache;
    # it falls through to the modern front controller below.
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else — including any URL that happens to share a name
    # with a legacy directory like /admin/, /include/, or a stray
    # /index.php — goes through the modern front controller.
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>

# Belt-and-braces denial of dotfile access at the docroot (.env, .git,
# .htaccess itself, etc.). `Require` is .htaccess-legal — only
# `<Directory>` / `<DirectoryMatch>` are server-config-only.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
