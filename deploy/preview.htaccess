# Preview-channel root .htaccess.
#
# Placed by the GitHub Actions preview-deploy workflow at the docroot
# (typically /home/<user>/domains/preview.paytracker.xyz/public_html/.htaccess).
# Routes every URL that doesn't map to a real file or directory through
# the modern front controller in public/index.php.
#
# This file is intentionally NOT named `.htaccess` in the repository so
# it stays inert during local development — the workflow renames it on
# deploy.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to the application source tree. Only the
    # `public/` directory is meant to be web-reachable; everything else is
    # framework guts.
    #
    # NB: <Directory> / <DirectoryMatch> blocks are server-config-only in
    # Apache and produce `<DirectoryMatch not allowed here` 500s when used
    # in .htaccess. We achieve the same effect with a RewriteRule that
    # returns 403 (the `[F]` flag) for any URL whose first path segment
    # names one of the protected directories.
    RewriteRule ^(app|bootstrap|config|routes|resources|storage|tests|vendor|deploy|docs|scripts)(/|$) - [F,L]

    # Static-asset passthrough — anything that maps to a real file or
    # directory under the docroot serves directly (e.g. public/assets/
    # CSS, the logo SVG, robots.txt if/when we add one). The legacy
    # `^/.+/public/` URI scoping is gone now that the deploy lives on
    # its own subdomain rather than sharing a docroot with the legacy
    # PHP tree.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the modern front controller.
    RewriteRule ^ public/index.php [L,QSA]
</IfModule>

# Belt-and-braces denial of dotfile access at the docroot (.env, .git,
# .htaccess itself, etc.). `Require` is .htaccess-legal — only
# `<Directory>` / `<DirectoryMatch>` are server-config-only.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
