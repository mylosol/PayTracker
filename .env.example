# PayTracker — Environment configuration template.
#
# Copy this file to `.env` for local development. On the production and
# preview hosts, the CI/CD pipeline writes the live `.env` from GitHub
# Actions secrets — it must NEVER be committed to source control.

APP_ENV=local
APP_DEBUG=true
APP_NAME="PayTracker"
APP_URL=http://localhost
APP_TIMEZONE="America/Chicago"

# 32-byte (256-bit) random key used by the session cookie signer and
# password rehashing. Generate with: `php -r "echo bin2hex(random_bytes(32));"`
APP_KEY=

# --- Database (MariaDB / MySQL) ----------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=paytracking
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Session & security ------------------------------------------------------
SESSION_NAME=paytracker_session
SESSION_LIFETIME_MIN=120
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax

# --- Third-party APIs --------------------------------------------------------
GOOGLE_MAPS_API_KEY=
