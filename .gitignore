storage/logs/*.log
storage/cache/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep

# --- OS metadata ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Log files and debug dumps ----------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*

# --- IDE / editor -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
